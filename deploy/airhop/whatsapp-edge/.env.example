# Brazilian public Channel Gateway edge. Copy to `.env` on the VPS and keep it
# outside version control. Use an immutable release tag or image digest.
AIRHOP_CHANNEL_GATEWAY_IMAGE=CHANGE_ME_IMAGE@sha256:CHANGE_ME_DIGEST
AIRHOP_EDGE_COMPOSE_PROJECT_NAME=airhop-channel-edge-br

# Public HTTPS origin of the authoritative Center relay. The edge uses NIP-98
# authentication for assignment, credential, heartbeat, inbox, and outbox APIs.
AIRHOP_GATEWAY_RELAY_URL=https://CHANGE_ME_CENTER_HOST

# Reuse the currently registered connector identity during cutover. Enter the
# 64-hex secret directly on the VPS; never copy it through chat or commit it.
AIRHOP_CONNECTOR_SECRET_KEY=CHANGE_ME_64_HEX

# DNS A/AAAA records must point to this Brazilian VPS before Caddy starts.
AIRHOP_WHATSAPP_PUBLIC_HOST=hooks.airhop.com.br
# Preflight fence. Set it to the Brazilian VPS public address before running
# ./preflight.sh; it is not passed into the containers.
AIRHOP_EXPECTED_PUBLIC_IP=
AIRHOP_GATEWAY_LOG_LEVEL=INFO
