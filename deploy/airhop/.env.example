# Immutable image tag is preferred after the first successful GitHub build.
AIRHOP_IMAGE=ghcr.io/makeev11/airhop-center:main
AIRHOP_HTTP_PORT=3300
AIRHOP_HQ_API_ORIGIN=https://hq.airhop.ru
AIRHOP_COMPOSE_PROJECT_NAME=airhop-center-demo
AIRHOP_DOCKER_NETWORK=airhop-center-demo-net

# Optional existing Traefik integration. Keep disabled for a local-only stack.
AIRHOP_TRAEFIK_ENABLED=false
AIRHOP_PUBLIC_HOST=demo.example.com

# Public address used by the native app and reverse proxy.
RELAY_URL=wss://demo.example.com
BUZZ_CORS_ORIGINS=https://demo.example.com
BUZZ_MEDIA_BASE_URL=https://demo.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=demo.example.com

BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_RECONCILE_CHANNELS=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info

# Generate every secret independently. Never commit the resulting .env file.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
# Public x-only key of the first AirHop Center owner provisioned by HQ.
RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_64_HEX
POSTGRES_DB=airhop
POSTGRES_USER=airhop
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
BUZZ_S3_ACCESS_KEY=CHANGE_ME
BUZZ_S3_SECRET_KEY=CHANGE_ME
BUZZ_S3_BUCKET=airhop-media

# Public booking encryption/key-rotation boundary.
BUZZ_AIRHOP_PUBLIC_BOOKING_INDEX_KEY=CHANGE_ME_64_HEX
BUZZ_AIRHOP_PUBLIC_BOOKING_MANAGEMENT_KEYS=1:CHANGE_ME_64_HEX
BUZZ_AIRHOP_PUBLIC_BOOKING_CURRENT_KEY_VERSION=1
BUZZ_AIRHOP_PUBLIC_BOOKING_READ_REQUESTS_PER_MINUTE=120
BUZZ_AIRHOP_PUBLIC_BOOKING_IP_REQUESTS_PER_MINUTE=10
BUZZ_AIRHOP_PUBLIC_BOOKING_PHONE_REQUESTS_PER_HOUR=5

# Self-service channel credentials. The index key is stable; retain old
# encryption-key versions until every stored credential has been rewrapped.
BUZZ_AIRHOP_CHANNEL_CREDENTIAL_INDEX_KEY=CHANGE_ME_64_HEX
BUZZ_AIRHOP_CHANNEL_CREDENTIAL_KEYS=1:CHANGE_ME_64_HEX
BUZZ_AIRHOP_CHANNEL_CURRENT_KEY_VERSION=1

# Enable only when the reverse proxy overwrites this header with one exact IP.
# BUZZ_AIRHOP_PUBLIC_BOOKING_CLIENT_IP_HEADER=x-real-ip

# HQ operator plane. Leave disabled until an operator key/origin is configured.
# RELAY_OPERATOR_PUBKEYS=CHANGE_ME_64_HEX_PUBLIC_KEY
# RELAY_OPERATOR_API_ORIGIN=https://demo.example.com

# Telegram Channel Gateway (`docker compose --profile telegram ...`).
# This is one deployment identity for all Telegram connections in this Center.
# Users add BotFather tokens in Airhop Center; tokens are not placed in this file.
AIRHOP_GATEWAY_RELAY_URL=https://demo.example.com
AIRHOP_TELEGRAM_CONNECTOR_SECRET_KEY=CHANGE_ME_64_HEX
AIRHOP_TELEGRAM_CONNECTOR_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
# Optional legacy single-connection mode:
# AIRHOP_TELEGRAM_CONNECTION_ID=CHANGE_ME_UUID
# AIRHOP_TELEGRAM_BOT_TOKEN=CHANGE_ME
# Polling is the default. Set all three values only for webhook mode.
# AIRHOP_TELEGRAM_WEBHOOK_URL=https://gateway.example.com/telegram
# AIRHOP_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_HIGH_ENTROPY
# AIRHOP_TELEGRAM_WEBHOOK_PORT=8443

# Hosted Hermes parent administrator (`docker compose --profile hermes ...`).
# Use the public tenant URL. The relay host selects the correct Center and is
# covered by NIP-98 authentication.
AIRHOP_HERMES_RELAY_URL=wss://demo.example.com
AIRHOP_HERMES_AGENT_SECRET_KEY=CHANGE_ME_64_HEX
AIRHOP_HERMES_AGENT_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
DEEPSEEK_API_KEY=CHANGE_ME
AIRHOP_HERMES_MODEL=deepseek-v4-flash
# Hard cost/loop bounds for one parent turn. The runtime also has one worker
# and no autonomous heartbeat.
AIRHOP_HERMES_MAX_ITERATIONS=8
AIRHOP_HERMES_IDLE_TIMEOUT_SECONDS=180
AIRHOP_HERMES_MAX_TURN_SECONDS=300
