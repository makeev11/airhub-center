# Immutable image tag is preferred after the first successful GitHub build.
AIRHOP_IMAGE=ghcr.io/makeev11/airhop-center:main
AIRHOP_HTTP_PORT=3300
AIRHOP_HQ_API_ORIGIN=https://hq.airhop.ru

# Public address used by the native app and reverse proxy.
RELAY_URL=wss://demo.example.com
BUZZ_CORS_ORIGINS=https://demo.example.com
BUZZ_MEDIA_BASE_URL=https://demo.example.com/media
BUZZ_MEDIA_SERVER_DOMAIN=demo.example.com

BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_RECONCILE_CHANNELS=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info

# Generate every secret independently. Never commit the resulting .env file.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
# Public x-only key of the first AirHop Center owner provisioned by HQ.
RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_64_HEX
POSTGRES_DB=airhop
POSTGRES_USER=airhop
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
BUZZ_S3_ACCESS_KEY=CHANGE_ME
BUZZ_S3_SECRET_KEY=CHANGE_ME
BUZZ_S3_BUCKET=airhop-media

# Public booking encryption/key-rotation boundary.
BUZZ_AIRHOP_PUBLIC_BOOKING_INDEX_KEY=CHANGE_ME_64_HEX
BUZZ_AIRHOP_PUBLIC_BOOKING_MANAGEMENT_KEYS=1:CHANGE_ME_64_HEX
BUZZ_AIRHOP_PUBLIC_BOOKING_CURRENT_KEY_VERSION=1
BUZZ_AIRHOP_PUBLIC_BOOKING_READ_REQUESTS_PER_MINUTE=120
BUZZ_AIRHOP_PUBLIC_BOOKING_IP_REQUESTS_PER_MINUTE=10
BUZZ_AIRHOP_PUBLIC_BOOKING_PHONE_REQUESTS_PER_HOUR=5

# Enable only when the reverse proxy overwrites this header with one exact IP.
# BUZZ_AIRHOP_PUBLIC_BOOKING_CLIENT_IP_HEADER=x-real-ip

# HQ operator plane. Leave disabled until an operator key/origin is configured.
# RELAY_OPERATOR_PUBKEYS=CHANGE_ME_64_HEX_PUBLIC_KEY
# RELAY_OPERATOR_API_ORIGIN=https://demo.example.com
